<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"    android:orientation="1"    android:background="@7F0502F2"    android:padding="15dp"    android:layout_width="-1"    android:layout_height="-1">    <Button        android:textSize="14sp"        android:textStyle="0x00000001"        android:textColor="@7F050021"        android:layout_gravity="0x00800003"        android:id="@7F08005C"        android:background="@7F070082"        android:layout_width="120dp"        android:layout_height="50dp"        android:text="返回主菜单" />    <LinearLayout        android:gravity="0x00000011"        android:orientation="0"        android:layout_width="-1"        android:layout_height="0dp"        android:layout_marginTop="15dp"        android:layout_marginBottom="15dp"        android:layout_weight="1.0">        <LinearLayout            android:gravity="0x00000011"            android:id="@7F0800E0"            android:background="@7F070082"            android:padding="15dp"            android:layout_width="0dp"            android:layout_height="-2"            android:layout_weight="1.0"            android:layout_marginStart="10dp"            android:layout_marginEnd="10dp">            <GridLayout                android:id="@7F0800DF"                android:background="@7F05005D"                android:padding="2dp"                android:layout_width="-2"                android:layout_height="-2"                android:rowCount="20"                android:columnCount="10" />        </LinearLayout>        <LinearLayout            android:gravity="0x00000011"            android:orientation="1"            android:id="@7F0800E1"            android:background="@7F070082"            android:padding="20dp"            android:layout_width="200dp"            android:layout_height="-2"            android:layout_marginEnd="10dp">            <LinearLayout                android:gravity="0x00000011"                android:orientation="1"                android:background="@7F0502F2"                android:padding="15dp"                android:layout_width="-1"                android:layout_height="-2"                android:layout_marginBottom="20dp">                <TextView                    android:textSize="22sp"                    android:textStyle="0x00000001"                    android:textColor="@7F050021"                    android:id="@7F080193"                    android:layout_width="-2"                    android:layout_height="-2"                    android:text="得分: 0" />            </LinearLayout>            <TextView                android:textSize="20sp"                android:textStyle="0x00000001"                android:textColor="@7F050021"                android:gravity="0x00000011"                android:id="@7F08015C"                android:layout_width="-1"                android:layout_height="-2"                android:layout_marginBottom="12dp"                android:text="下一个方块" />            <LinearLayout                android:gravity="0x00000011"                android:background="@7F0502F2"                android:padding="12dp"                android:layout_width="-1"                android:layout_height="-2"                android:layout_marginLeft="5dp"                android:layout_marginRight="5dp"                android:layout_marginHorizontal="5dp">                <GridLayout                    android:id="@7F08015B"                    android:background="@7F05005D"                    android:layout_width="-2"                    android:layout_height="-2"                    android:rowCount="4"                    android:columnCount="4" />            </LinearLayout>        </LinearLayout>    </LinearLayout>    <LinearLayout        android:gravity="0x00000011"        android:orientation="1"        android:id="@7F080090"        android:paddingLeft="15dp"        android:paddingRight="15dp"        android:layout_width="-1"        android:layout_height="-2"        android:layout_marginBottom="20dp"        android:paddingHorizontal="15dp">        <LinearLayout            android:gravity="0x00000011"            android:orientation="0"            android:id="@7F08008C"            android:background="@7F070082"            android:padding="15dp"            android:layout_width="-2"            android:layout_height="-2"            android:layout_marginBottom="15dp">            <LinearLayout                android:gravity="0x00000011"                android:orientation="1"                android:layout_width="-2"                android:layout_height="-2"                android:layout_marginRight="30dp">                <LinearLayout                    android:orientation="0"                    android:layout_width="-2"                    android:layout_height="-2"                    android:layout_marginBottom="15dp">                    <Button                        android:textSize="18sp"                        android:textStyle="0x00000001"                        android:textColor="@7F050021"                        android:id="@7F08010A"                        android:background="@7F070082"                        android:layout_width="80dp"                        android:layout_height="80dp"                        android:layout_marginRight="15dp"                        android:text="左移" />                    <Button                        android:textSize="18sp"                        android:textStyle="0x00000001"                        android:textColor="@7F050021"                        android:id="@7F080188"                        android:background="@7F070082"                        android:layout_width="80dp"                        android:layout_height="80dp"                        android:text="右移" />                </LinearLayout>                <Button                    android:textSize="18sp"                    android:textStyle="0x00000001"                    android:textColor="@7F050021"                    android:id="@7F0800B4"                    android:background="@7F070082"                    android:layout_width="80dp"                    android:layout_height="80dp"                    android:text="下移" />            </LinearLayout>            <LinearLayout                android:gravity="0x00000011"                android:orientation="1"                android:layout_width="-2"                android:layout_height="-2">                <Button                    android:textSize="18sp"                    android:textStyle="0x00000001"                    android:textColor="@7F050021"                    android:id="@7F08018B"                    android:background="@7F070082"                    android:layout_width="80dp"                    android:layout_height="80dp"                    android:text="旋转" />            </LinearLayout>        </LinearLayout>        <Button            android:textSize="22sp"            android:textStyle="0x00000001"            android:textColor="@7F050021"            android:id="@7F0800CE"            android:background="@7F070082"            android:layout_width="-1"            android:layout_height="60dp"            android:text="快速下落" />    </LinearLayout></LinearLayout>